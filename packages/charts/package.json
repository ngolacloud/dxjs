{
  "name": "@dxjs/charts",
  "version": "1.5.0",
  "description": "CSP-safe chart components for dxjs: a thin, signal-reactive wrapper over Chart.js (bar / line / pie / doughnut) rendered to a <canvas>.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "//exports": "types -> .d.ts, published default -> dist/index.js; the 'development' condition (node --conditions=development) resolves to TS source for intra-repo dev/tests.",
  "files": [
    "dist",
    "src",
    "charts.css",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dxjs/core": "1.5.0",
    "@dxjs/dom": "1.5.0",
    "@dxjs/component": "1.5.0",
    "chart.js": "^4.6.1"
  },
  "keywords": [
    "dxjs",
    "charts",
    "chart.js",
    "canvas",
    "csp",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngolacloud/dxjs.git",
    "directory": "packages/charts"
  }
}
