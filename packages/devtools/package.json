{
  "name": "@dxjs/devtools",
  "version": "0.0.1",
  "description": "dxjs devtools: a signals inspector that snapshots the live reactive graph (signals/computeds/effects, values, recompute counts) via the @dxjs/core inspector hook. Dev-only; zero-cost when not installed.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "dependencies": { "@dxjs/core": "0.0.1" },
  "keywords": ["dxjs", "devtools", "inspector", "signals", "reactivity"],
  "repository": { "type": "git", "url": "https://github.com/ngolacloud/dxjs.git", "directory": "packages/devtools" }
}
