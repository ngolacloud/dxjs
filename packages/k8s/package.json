{
  "name": "@dxjs/k8s",
  "version": "1.0.0",
  "description": "dxjs k8s: a Kubernetes resource explorer. A watch store (ADDED/MODIFIED/DELETED + resourceVersion resume cursor) and a live explorer view over @dxjs/ui dataTable. Transport-agnostic, CSP-safe.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dxjs/core": "1.0.0",
    "@dxjs/dom": "1.0.0",
    "@dxjs/ui": "1.0.0"
  },
  "keywords": [
    "dxjs",
    "kubernetes",
    "k8s",
    "watch",
    "explorer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngolacloud/dxjs.git",
    "directory": "packages/k8s"
  }
}
