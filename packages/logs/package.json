{
  "name": "@dxjs/logs",
  "version": "1.1.0",
  "description": "dxjs logs: a virtualized multi-source log viewer. Merges lines by time, filters by level/source/text, renders only the visible window via @dxjs/ui virtualList. Escaped, CSP-safe.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dxjs/core": "1.1.0",
    "@dxjs/dom": "1.1.0",
    "@dxjs/ui": "1.1.0"
  },
  "keywords": [
    "dxjs",
    "logs",
    "log-viewer",
    "virtualized",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngolacloud/dxjs.git",
    "directory": "packages/logs"
  }
}
