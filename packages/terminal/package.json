{
  "name": "@dxjs/terminal",
  "version": "1.5.0",
  "description": "dxjs terminal: a resilient, CSP-safe line-oriented web terminal whose output rides a @dxjs/transport LiveSource (SSE reconnect/backoff/resume). Escaped output, no eval/inline.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dxjs/core": "1.5.0",
    "@dxjs/dom": "1.5.0"
  },
  "keywords": [
    "dxjs",
    "terminal",
    "xterm",
    "sse",
    "resilient",
    "csp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngolacloud/dxjs.git",
    "directory": "packages/terminal"
  }
}
