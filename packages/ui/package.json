{
  "name": "@dxjs/ui",
  "version": "1.1.0",
  "description": "A styled, CSP-safe component kit for the NgolaCloud/Seiva console: app shell, stat cards, and a sortable/searchable/paginated data table.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "//exports": "types -> .d.ts, published default -> dist/index.js; the 'development' condition (node --conditions=development) resolves to TS source for intra-repo dev/tests.",
  "files": [
    "dist",
    "src",
    "ui.css",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dxjs/core": "1.1.0",
    "@dxjs/dom": "1.1.0",
    "@dxjs/component": "1.1.0"
  },
  "keywords": [
    "dxjs",
    "ui",
    "components",
    "admin",
    "table",
    "csp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngolacloud/dxjs.git",
    "directory": "packages/ui"
  }
}
